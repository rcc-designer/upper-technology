# Public origin, no trailing slash. Set the REAL origin before build/deploy.
# Leave blank for local review: indexing is disabled until configured.
NEXT_PUBLIC_SITE_URL=

# Required for real form delivery. Server only.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_SECRET=
TURNSTILE_SECRET_KEY=
# Public Cloudflare Turnstile widget key; allow your actual hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Vercel automatically uses its trusted x-vercel-forwarded-for header.
# Other hosts: set a header that YOUR reverse proxy overwrites, not user input.
TRUSTED_IP_HEADER=

# Optional CRM webhook. HTTPS only. Server only.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Optional Google Analytics 4 measurement ID (G-...); consent UI activates when set.
NEXT_PUBLIC_GA_ID=
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=

# Deployment checklist flags: set true only AFTER owner/legal/content review.
LEGAL_REVIEWED=false
BUSINESS_DETAILS_CONFIRMED=false
